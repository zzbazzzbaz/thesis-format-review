DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_LOG_LEVEL=INFO
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

SQLITE_DB_PATH=data/db.sqlite3
MEDIA_ROOT=media

THESIS_REVIEW_BASE_URL=http://127.0.0.1:8001
THESIS_REVIEW_TIMEOUT_SECONDS=300

JWT_ACCESS_TOKEN_SECONDS=7200
JWT_REFRESH_TOKEN_SECONDS=604800

# Deploy-only optional values. They are ignored by Django but can be used by
# deploy/docker-compose.yml when this file is copied to /home/ubuntu/thesis-review/.env.
IMAGE_TAG=latest
BACKEND_HOST_PORT=18180
FRONTEND_HOST_PORT=18181
